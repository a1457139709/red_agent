{
  "version": 1,
  "name": "weather-query-example",
  "kind": "skill",
  "display_name": "Weather Query Example",
  "description": "Query example weather conditions for a supported city by running the bundled local weather script.",
  "modes": ["normal"],
  "parameters": [
    {
      "name": "city",
      "type": "string",
      "required": false,
      "description": "Supported demo city to look up."
    }
  ],
  "tools": {
    "allowed": ["bash", "list_dir", "read_file"]
  },
  "risk": {
    "default": "safe",
    "actions": []
  },
  "execution": {
    "style": "prompt_assist",
    "profile": "weather-query-example"
  },
  "session": {
    "supports_one_shot": true,
    "supports_persistent": true,
    "result_layers": []
  }
}
